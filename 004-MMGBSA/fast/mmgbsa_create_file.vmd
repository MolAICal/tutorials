-ligand_selection       "segname C" \
-pb_gb_temperature      310.0 \
-first_frame     0 \
-last_frame      -1 \
-frame_stride    1 \
-mm_dielectric        1 \
-poisson_boltzmann    0 \
-surface_accessibility        0 \
-gb_surface_gamma  0.0072 \
-generalized_born	  1 \
-gb_surface_area     1 \
-namd_executable E:/workdir/MolAICal/method/mmgbsa_v1/mmpbsa/namd2/namd2.exe
